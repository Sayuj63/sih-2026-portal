# For local dev (SQLite):
DATABASE_URL="file:./dev.db"

# 32+ char random string. Rotate for every deployment.
SESSION_SECRET="rotate-me-with-openssl-rand-hex-32-value"
OTP_PEPPER="rotate-me-second-value-for-otp-hmac"

COLLEGE_SLUG="isu"
COLLEGE_NAME="ISU"
COLLEGE_EMAIL_DOMAIN="isu.ac.in"
TIMEZONE="Asia/Kolkata"

# Server clock is authoritative. Format: ISO 8601 with offset.
REGISTRATION_OPEN_AT="2026-06-01T00:00:00+05:30"
REGISTRATION_CLOSE_AT="2026-08-31T23:59:59+05:30"

TEAM_SIZE="6"
MIN_FEMALE_MEMBERS="1"

# "true" prints OTPs to the server console (dev only). Set to "false" in production.
DEV_ECHO_OTP="true"

# Optional: bring your own SMTP for production email.
SMTP_URL=""
SMTP_FROM="SIH Registration <no-reply@isu.ac.in>"

# Seeded admin password. Change this before first seed in a real environment.
ADMIN_SEED_PASSWORD="ChangeMe#SIH2026"
